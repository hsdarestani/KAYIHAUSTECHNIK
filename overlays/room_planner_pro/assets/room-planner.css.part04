12px 16px 0}.rp-photo-previews{padding-left:16px;padding-right:16px}.rp-calibration{margin:12px 16px 0;grid-template-columns:1fr 1fr}.rp-calibration>div{grid-column:1/-1}.rp-dialog-actions{padding:12px 16px 18px}.rp-dialog-actions .nx-btn{flex:1}.rp-drag-metrics{min-width:160px;font-size:8px}}
/* Runtime inspector + live measurement polish */
.rp-inspector-form>label,.rp-form-grid label{display:grid;gap:4px;font-size:8px;font-weight:850;color:#78828b;margin-bottom:8px}.rp-inspector-form input,.rp-inspector-form select{width:100%;border:1px solid #dfe3e5;border-radius:9px;background:#fbfcfc;padding:8px;font:700 10px/1.2 inherit;color:#242b31;outline:none}.rp-inspector-form input:focus,.rp-inspector-form select:focus{border-color:#7bb4b7;box-shadow:0 0 0 3px rgba(38,124,130,.1)}.rp-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px 8px}.rp-check{display:flex!important;grid-column:1/-1;align-items:center;gap:7px!important}.rp-check input{width:auto}.rp-inspector-head>div:first-child{display:grid;gap:2px}.rp-inspector-head>div:first-child>span{font-size:8px;color:#7d878f;font-weight:850;text-transform:uppercase;letter-spacing:.04em}.rp-inspector-head>div:first-child>strong{font-size:12px}.rp-inspector-head>button{border:1px solid #e1e4e6;background:#fff;border-radius:8px;width:30px;height:30px;cursor:pointer;color:#a1433d}.rp-distance-card>strong{display:block;font-size:9px;margin-bottom:7px}.rp-distance-card>div{display:grid;grid-template-columns:1fr 1fr;gap:5px}.rp-distance-card>div span{display:flex;justify-content:space-between;gap:5px;font-size:8px;color:#6d777f}.rp-distance-card>div b{color:#29343c}.rp-distance-card p{font-size:8px;color:#6d777f;margin:7px 0 0}.rp-ai-evidence{margin-top:10px;border-radius:10px;padding:9px;background:#fff8e7;border:1px solid #f0deb2;color:#725d26;font-size:8.5px;line-height:1.5}.rp-ai-evidence strong{display:block;margin-bottom:3px}.rp-ai-evidence p{margin:0}.rp-hud-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px 9px;margin:5px 0}.rp-collision{color:#ffaaa4;font-size:8px;margin-left:5px}.rp-toast{position:fixed;right:18px;bottom:18px;z-index:9999;max-width:min(360px,calc(100vw - 36px));background:#20282e;color:#fff;border-radius:12px;padding:11px 13px;font:750 10px/1.4 inherit;box-shadow:0 18px 50px rgba(0,0,0,.2);opacity:0;transform:translateY(10px);pointer-events:none;transition:.2s ease}.rp-toast.show{opacity:1;transform:none}.rp-toast[data-type="success"]{background:#205c4a}.rp-toast[data-type="error"]{background:#8a3e38}.rp-drag-metrics{transform:translate(-50%,-115%);transition:left .035s linear,top .035s linear}.rp-drag-metrics[hidden]{display:none}.rp-vision-feedback{margin:12px 20px 0;border:1px solid #dce7e7;background:#f4f9f9;border-radius:12px;padding:10px 12px;font-size:9px;line-height:1.5}.rp-vision-feedback[hidden]{display:none}.rp-vision-feedback ul{margin:6px 0 0;padding-left:18px}
@media(max-width:720px){.rp-form-grid{grid-template-columns:1fr 1fr}.rp-drag-metrics{max-width:75vw}.rp-toast{right:10px;bottom:76px}}
