:root{--rp-bg:#f5f6f7;--rp-panel:#fff;--rp-ink:#171b20;--rp-muted:#69727c;--rp-line:#e3e6e8;--rp-accent:#1d6e74;--rp-accent-2:#24546d;--rp-ai:#6e56cf;--rp-danger:#c8413b;--rp-radius:18px;--rp-shadow:0 14px 40px rgba(24,32,40,.08)}
.rp-page{max-width:1680px;margin:0 auto;padding-bottom:32px}.rp-pagehead{margin-bottom:14px}.rp-pagehead h1{letter-spacing:-.035em}.rp-startbar{display:flex;align-items:center;justify-content:space-between;gap:18px;background:linear-gradient(130deg,#14252b,#214751);color:#fff;border-radius:18px;padding:18px 20px;margin-bottom:14px;box-shadow:var(--rp-shadow)}.rp-startbar>div:first-child{display:flex;gap:13px;align-items:center}.rp-startbar small{display:block;color:rgba(255,255,255,.72);margin-top:3px}.rp-start-icon{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;background:rgba(255,255,255,.1);font-size:22px}.rp-start-actions{display:flex;gap:8px;flex-wrap:wrap}.rp-startbar .nx-btn:not(.nx-btn-primary){border-color:rgba(255,255,255,.2);color:#fff;background:rgba(255,255,255,.08)}
.rp-meta-row{display:grid;grid-template-columns:minmax(180px,280px) 1fr auto;align-items:end;gap:12px;padding:10px 12px;border:1px solid var(--rp-line);border-radius:16px;background:#fff;margin-bottom:12px}.rp-room-switcher label{display:grid;gap:5px;font-size:11px;font-weight:800;color:var(--rp-muted)}.rp-room-switcher .nx-control{min-height:38px}.rp-meta-pills{display:flex;align-items:center;gap:7px;flex-wrap:wrap;padding-bottom:2px}.rp-meta-pills span{font-size:11px;font-weight:800;color:#47515b;background:#f3f5f6;border:1px solid #e6e8ea;padding:7px 10px;border-radius:999px}.rp-meta-actions{display:flex;gap:7px;align-items:center}.rp-meta-actions .nx-btn{min-height:38px}
.rp-layout{display:grid;grid-template-columns:280px minmax(520px,1fr) 300px;gap:12px;align-items:start}.rp-panel,.rp-stage-card{background:var(--rp-panel);border:1px solid var(--rp-line);border-radius:var(--rp-radius);box-shadow:0 8px 28px rgba(31,41,51,.045);overflow:hidden}.rp-panel{position:sticky;top:76px;max-height:calc(100vh - 92px);overflow:auto;scrollbar-width:thin}.rp-panel-title{display:flex;justify-content:space-between;align-items:center;padding:16px 16px 12px;border-bottom:1px solid var(--rp-line);position:sticky;top:0;background:rgba(255,255,255,.96);backdrop-filter:blur(14px);z-index:4}.rp-panel-title b{font-size:13px}.rp-panel-title small{display:block;color:var(--rp-muted);font-size:10px;margin-top:2px}.rp-ai-hero{margin:12px;width:calc(100% - 24px);border:0;border-radius:14px;background:linear-gradient(135deg,#f0edff,#eef7fa);padding:12px;display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;text-align:left;color:var(--rp-ink);cursor:pointer}.rp-ai-hero>span{width:34px;height:34px;border-radius:10px;background:#fff;display:grid;place-items:center;color:var(--rp-ai);font-weight:900;box-shadow:0 4px 14px rgba(64,47,123,.12)}.rp-ai-hero b{font-size:11px}.rp-ai-hero small{display:block;color:#69727c;font-size:9px;line-height:1.45;margin-top:2px}.rp-ai-hero i{font-style:normal;color:#7765c4}
.rp-tool-section{border-top:1px solid var(--rp-line)}.rp-tool-section summary{list-style:none;padding:12px 15px;font-size:11px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:space-between}.rp-tool-section summary::-webkit-details-marker{display:none}.rp-tool-section summary:after{content:'+';font-size:15px;color:#8b949c;font-weight:500}.rp-tool-section[open] summary:after{content:'−'}.rp-tool-section>div{padding:0 12px 12px}.rp-room-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px}.rp-room-fields label{font-size:9px;font-weight:800;color:#76808a}.rp-room-fields label>div{position:relative;margin-top:4px}.rp-room-fields input{width:100%;border:1px solid #dde1e4;border-radius:10px;padding:9px 28px 9px 9px;font:700 12px/1.2 inherit;background:#fafbfb;color:#20262c}.rp-room-fields em{position:absolute;right:8px;top:9px;font-style:normal;font-size:9px;color:#939ba2}.rp-add-row{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.rp-add-row button,.rp-object-grid button{border:1px solid #e1e4e6;background:#fff;border-radius:11px;color:#303840;cursor:pointer;transition:.15s ease}.rp-add-row button:hover,.rp-object-grid button:hover{border-color:#9dc5c8;background:#f4fbfb;transform:translateY(-1px)}.rp-add-row button{padding:10px 5px;font:800 9px/1.1 inherit;display:grid;gap:7px;place-items:center}.rp-add-row button:disabled,.rp-object-grid button:disabled{opacity:.4;cursor:not-allowed;transform:none}.rp-door-icon,.rp-window-icon,.rp-opening-icon{display:block;width:22px;height:24px;border:2px solid #697983;border-bottom:0;border-radius:2px}.rp-window-icon{height:18px;border-bottom:2px solid #697983;position:relative}.rp-window-icon:after{content:'';position:absolute;left:9px;top:0;bottom:0;border-left:1px solid #697983}.rp-opening-icon{border-style:dashed}.rp-object-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.rp-object-grid button{min-height:65px;padding:7px 4px;display:grid;place-items:center;gap:4px}.rp-object-grid button b{font-size:8.5px;line-height:1.15}.rp-object-grid span{width:28px;height:24px;display:block;position:relative;border-radius:5px;background:linear-gradient(145deg,#dce2e6,#aeb8bf);box-shadow:inset -5px -5px 8px rgba(0,0,0,.07),inset 4px 4px 7px rgba(255,255,255,.5)}.rp-object-grid span:before,.rp-object-grid span:after{content:'';position:absolute}.rp-object-grid [data-rp-lib-icon="radiator"]{background:repeating-linear-gradient(90deg,#e5e9ec 0 3px,#aab5bd 3px 5px);border-radius:3px}.rp-object-grid [data-rp-lib-icon="washing_machine"],.rp-object-grid [data-rp-lib-icon="dryer"]{border-radius:4px}.rp-object-grid [data-rp-lib-icon="washing_machine"]:after,.rp-object-grid [data-rp-lib-icon="dryer"