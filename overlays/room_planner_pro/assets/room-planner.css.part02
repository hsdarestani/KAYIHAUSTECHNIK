]:after{width:12px;height:12px;border:2px solid #6e7c86;border-radius:50%;left:6px;top:6px}.rp-object-grid [data-rp-lib-icon="toilet"]{border-radius:12px 12px 7px 7px}.rp-object-grid [data-rp-lib-icon="bathtub"]{height:16px;border-radius:9px}.rp-object-grid [data-rp-lib-icon="shower"]{background:linear-gradient(90deg,rgba(115,196,218,.18),rgba(74,155,182,.35));border:1px solid #91c8d7}.rp-object-grid [data-rp-lib-icon="socket"],.rp-object-grid [data-rp-lib-icon="switch"]{width:20px;height:20px;background:#f4f4f1;border:1px solid #cfd3d4}
.rp-stage-card{min-width:0}.rp-toolbar{height:52px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;padding:7px 9px;border-bottom:1px solid var(--rp-line);background:#fff}.rp-toolbar button{border:1px solid transparent;background:transparent;border-radius:9px;padding:8px 10px;font:800 9px/1 inherit;color:#66717a;cursor:pointer;white-space:nowrap}.rp-toolbar button:hover{background:#f3f5f6;color:#252c31}.rp-toolbar button.is-active{background:#e9f4f4;color:#185b60;border-color:#c7e1e2}.rp-view-group{display:flex;background:#f3f5f6;border-radius:11px;padding:3px}.rp-view-group button{padding:7px 12px}.rp-toolbar-center{display:flex;justify-content:center;gap:2px;min-width:0;overflow:auto}.rp-toolbar-end{display:flex;justify-content:flex-end;gap:2px}.rp-canvas-wrap{height:min(68vh,720px);min-height:520px;position:relative;background:radial-gradient(circle at 50% 35%,#f8fafb,#eef1f3 70%);overflow:hidden}.rp-canvas{display:block;width:100%;height:100%;touch-action:none;outline:none}.rp-canvas-loading{position:absolute;inset:0;display:grid;place-content:center;place-items:center;gap:12px;background:rgba(247,249,250,.92);z-index:8;color:#45515b}.rp-canvas-loading[hidden]{display:none}.rp-canvas-loading span{width:34px;height:34px;border:3px solid #dce3e5;border-top-color:var(--rp-accent);border-radius:50%;animation:rpSpin .8s linear infinite}@keyframes rpSpin{to{transform:rotate(360deg)}}.rp-engine-error{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:9;background:#fff7f5;border:1px solid #f1cbc4;border-radius:14px;padding:16px 18px;max-width:360px;text-align:center;color:#813e37}.rp-engine-error span{display:block;font-size:10px;margin-top:5px;line-height:1.5}.rp-scene-hint{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);background:rgba(20,27,32,.75);color:#fff;padding:8px 11px;border-radius:999px;font-size:9px;backdrop-filter:blur(8px);pointer-events:none;opacity:.9}.rp-axis{position:absolute;left:15px;bottom:14px;width:42px;height:42px;border-left:2px solid #df655e;border-bottom:2px solid #4c88c7;pointer-events:none}.rp-axis span{position:absolute;font-size:8px;font-weight:900}.rp-axis .x{left:-4px;top:-12px;color:#df655e}.rp-axis .z{right:-10px;bottom:-4px;color:#4c88c7}.rp-drag-metrics{position:absolute;z-index:7;min-width:185px;pointer-events:none;background:rgba(18,25,30,.9);color:#fff;border-radius:12px;padding:9px 10px;box-shadow:0 12px 32px rgba(0,0,0,.18);backdrop-filter:blur(8px);font-size:9px}.rp-drag-metrics .rp-metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 10px}.rp-drag-metrics b{font-size:10px}.rp-drag-metrics small{display:block;color:#b9c4ca}.rp-drag-metrics .is-danger{color:#ff9e97}.rp-stage-status{min-height:40px;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;padding:0 12px;border-top:1px solid var(--rp-line);font-size:9px;color:#78828b}.rp-stage-status>div:nth-child(2){text-align:center}.rp-stage-status>div:last-child{text-align:right}.rp-status-dot{width:7px;height:7px;border-radius:50%;background:#43a47b;display:inline-block;margin-right:6px}
.rp-inspector-empty{padding:14px}.rp-room-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}.rp-room-stats span{padding:11px;border:1px solid #e5e8ea;border-radius:12px;background:#fafbfb}.rp-room-stats small{display:block;color:#7a848d;font-size:8px}.rp-room-stats b{display:block;font-size:13px;margin-top:3px}.rp-help-card{margin-top:11px;background:#f3f7f7;border-radius:12px;padding:12px}.rp-help-card b{font-size:10px}.rp-help-card p{font-size:9px;color:#6b767f;line-height:1.55;margin:4px 0 0}.rp-inspector-form{padding:13px}.rp-inspector-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.rp-inspector-head>div{display:flex;gap:8px;align-items:center}.rp-inspector-icon{width:32px;height:32px;border-radius:9px;background:#edf2f3;display:grid;place-items:center;font-weight:900}.rp-inspector-head b{font-size:12px}.rp-inspector-head small{display:block;font-size:8px;color:#77818a;margin-top:2px}.rp-inspector-actions{display:flex;gap:4px}.rp-inspector-actions button{border:1px solid #e1e4e6;background:#fff;border-radius:8px;width:28px;height:28px;cursor:pointer;color:#59636c}.rp-inspector-actions button.is-danger{color:#a83c37}.rp-prop-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.rp-prop-grid label,.rp-prop-stack label{font-size:8px;font-weight:850;color:#78828b;display:grid;gap:4px}.rp-prop-grid input,.rp-prop-grid select,.rp-prop-stack input,.rp-prop-stack select{width:100%;border:1px solid #dfe3e5;border-radius:9px;background:#fbfcfc;padding:8px;font:700 10px/1.2 inherit;color:#242b31}.rp-prop-stack{display:grid;gap:8px}.rp-distance-card{margin-top:10px;border:1px solid #dce7e7;background:#f4f9f9;border-radius:11px;padding:9px}.rp-distance-card>small{display:block;font-size:8px;color:#6e797f;margin-bottom:6px}.rp-distance-values{display:grid;grid-template-columns:1fr 1fr;gap:4px;font-size:9px}.rp-distance-values span{display:flex;justify-content:space-between}.rp-confidence{margin-top:10px;border-radius:10px;padding:8px 9px;background:#fff8e7;border:1px solid #f0deb2;color:#725d26;font-size:8.5px;line-height:1.45}.rp-confidence.is-high{background: