#edf8f3;border-color:#cbe8da;color:#336b52}.rp-save-card{border-top:1px solid var(--rp-line);padding:13px;display:grid;gap:8px}.rp-save-card label{font-size:8px;font-weight:850;color:#78828b;display:grid;gap:4px}.rp-save-card small{color:#8a939b;font-size:8px;line-height:1.45}.rp-revisions{border-top:1px solid var(--rp-line)}.rp-revisions summary{list-style:none;padding:12px 14px;font-size:9px;font-weight:900;cursor:pointer}.rp-revisions summary::-webkit-details-marker{display:none}.rp-revisions>div{padding:0 10px 10px}.rp-revisions a,.rp-revisions span{display:block;border:1px solid #e4e7e9;border-radius:9px;padding:8px;margin-top:5px;color:#354049;text-decoration:none}.rp-revisions b{font-size:9px}.rp-revisions small{display:block;font-size:8px;color:#8a939a;margin-top:2px}.rp-revisions a a,.rp-revisions span a{display:inline;border:0;padding:0;color:#216b72;font-weight:850}
.rp-vision-dialog{border:0;padding:0;border-radius:22px;width:min(760px,calc(100vw - 28px));max-height:90vh;box-shadow:0 30px 80px rgba(22,29,35,.28);background:#fff}.rp-vision-dialog::backdrop{background:rgba(13,19,24,.48);backdrop-filter:blur(3px)}.rp-dialog-shell{padding:0;overflow:auto;max-height:90vh}.rp-dialog-head{display:flex;justify-content:space-between;gap:15px;align-items:flex-start;padding:20px 22px 16px;border-bottom:1px solid var(--rp-line)}.rp-dialog-head>div{display:flex;gap:12px}.rp-dialog-head h2{margin:2px 0 3px;font-size:21px;letter-spacing:-.03em}.rp-dialog-head p{margin:0;color:#727d86;font-size:10px}.rp-dialog-head>button{border:0;background:#f1f3f4;width:32px;height:32px;border-radius:10px;font-size:20px;color:#68727a;cursor:pointer}.rp-ai-mark{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:#f1edff;color:#725bcc;font-size:19px}.rp-capture-guide{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;padding:14px 22px 0}.rp-capture-guide span{border:1px solid #e2e5e7;border-radius:11px;padding:9px;display:grid;grid-template-columns:auto 1fr;column-gap:7px}.rp-capture-guide i{grid-row:1/3;width:20px;height:20px;border-radius:7px;background:#edf4f4;color:#276b70;display:grid;place-items:center;font-style:normal;font-size:8px;font-weight:900}.rp-capture-guide b{font-size:8.5px}.rp-capture-guide small{font-size:7.5px;color:#8a9298}.rp-photo-drop{margin:14px 22px 0;border:1.5px dashed #bec8ce;border-radius:16px;min-height:145px;display:grid;place-items:center;align-content:center;text-align:center;gap:5px;background:#fafbfc;cursor:pointer}.rp-photo-drop:hover{border-color:#7aabb0;background:#f5fbfb}.rp-photo-drop input{display:none}.rp-photo-drop b{font-size:11px}.rp-photo-drop small{font-size:8px;color:#8a939b}.rp-photo-orb{font-size:24px}.rp-photo-previews{padding:10px 22px 0;display:flex;gap:7px;overflow:auto}.rp-photo-previews figure{margin:0;width:78px;flex:0 0 78px}.rp-photo-previews img{width:78px;height:62px;object-fit:cover;border-radius:9px;display:block}.rp-photo-previews figcaption{font-size:7px;color:#7e878f;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rp-calibration{margin:14px 22px 0;padding:12px;border-radius:14px;background:#f5f7f8;display:grid;grid-template-columns:1.5fr 1fr .7fr .7fr;gap:8px;align-items:end}.rp-calibration>div b{font-size:9px}.rp-calibration>div small{display:block;font-size:7.5px;color:#838c94;line-height:1.4;margin-top:2px}.rp-calibration label{font-size:7.5px;font-weight:850;color:#78818a;display:grid;gap:4px}.rp-calibration .nx-control{min-height:34px;font-size:9px}.rp-vision-feedback{margin:12px 22px 0;border-radius:12px;padding:10px 12px;background:#edf8f3;border:1px solid #cce8db;color:#356e55;font-size:9px;line-height:1.55}.rp-vision-feedback.is-warning{background:#fff8e8;border-color:#f0dfb7;color:#735e29}.rp-vision-feedback.is-error{background:#fff1ef;border-color:#f0c9c4;color:#8a4039}.rp-dialog-actions{padding:14px 22px 20px;display:flex;justify-content:flex-end;gap:8px}
@media(max-width:1280px){.rp-layout{grid-template-columns:245px minmax(480px,1fr) 270px}.rp-object-grid{grid-template-columns:repeat(2,1fr)}.rp-toolbar-center button:nth-of-type(n+5){display:none}}
@media(max-width:1020px){.rp-layout{grid-template-columns:1fr}.rp-panel{position:relative;top:auto;max-height:none}.rp-library{order:2}.rp-stage-card{order:1}.rp-inspector{order:3}.rp-library .rp-tool-section{display:inline-block;vertical-align:top;width:calc(50% - 3px)}.rp-library>.rp-panel-title,.rp-library>.rp-ai-hero{display:flex}.rp-object-grid{grid-template-columns:repeat(4,1fr)}.rp-meta-row{grid-template-columns:1fr auto}.rp-meta-pills{grid-column:1/-1;order:3}.rp-canvas-wrap{min-height:480px;height:60vh}}
@media(max-width:720px){.rp-page{margin:-8px}.rp-pagehead{padding:0 8px}.rp-pagehead .nx-actions .nx-badge{display:none}.rp-startbar{border-radius:14px;margin:0 8px 10px;display:grid}.rp-meta-row{margin:0 8px 10px;grid-template-columns:1fr}.rp-meta-actions{justify-content:flex-start}.rp-layout{gap:8px}.rp-stage-card,.rp-panel{border-radius:14px}.rp-stage-card{border-left:0;border-right:0}.rp-toolbar{grid-template-columns:1fr auto;height:auto;min-height:50px}.rp-view-group{grid-column:1}.rp-toolbar-center{grid-row:2;grid-column:1/-1;justify-content:flex-start}.rp-toolbar-end{grid-column:2;grid-row:1}.rp-canvas-wrap{height:58vh;min-height:430px}.rp-scene-hint{font-size:7.5px;max-width:86%;text-align:center}.rp-stage-status{grid-template-columns:1fr 1fr}.rp-stage-status>div:nth-child(2){display:none}.rp-library,.rp-inspector{margin:0 8px}.rp-library .rp-tool-section{display:block;width:100%}.rp-object-grid{grid-template-columns:repeat(4,1fr)}.rp-vision-dialog{width:calc(100vw - 16px);border-radius:16px}.rp-dialog-head{padding:16px}.rp-capture-guide{padding:12px 16px 0;grid-template-columns:1fr 1fr}.rp-photo-drop{margin: