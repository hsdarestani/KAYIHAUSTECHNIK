    {"src": "/static/icons/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any maskable"}
  ],
  "shortcuts": [
    {"name": "Zeiterfassung", "url": "/app/", "icons": [{"src": "/static/icons/icon-192.svg", "sizes": "192x192"}]},
    {"name": "Termine", "url": "/calendar/", "icons": [{"src": "/static/icons/icon-192.svg", "sizes": "192x192"}]},
    {"name": "Neues Projekt", "url": "/projects/new/", "icons": [{"src": "/static/icons/icon-192.svg", "sizes": "192x192"}]}
  ]
